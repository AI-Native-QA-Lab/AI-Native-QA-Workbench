{
  "name": "ai-native-qa-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"*.{js,json,ts,yaml,yml}\" \"apps/**/*.{js,json,ts,yaml,yml}\" \"packages/**/*.{js,json,ts,yaml,yml}\" \"scripts/**/*.{js,json,ts,yaml,yml}\" \"tests/**/*.{js,json,ts,yaml,yml}\" \".github/**/*.{js,json,ts,yaml,yml}\"",
    "format:check": "prettier --check \"*.{js,json,ts,yaml,yml}\" \"apps/**/*.{js,json,ts,yaml,yml}\" \"packages/**/*.{js,json,ts,yaml,yml}\" \"scripts/**/*.{js,json,ts,yaml,yml}\" \"tests/**/*.{js,json,ts,yaml,yml}\" \".github/**/*.{js,json,ts,yaml,yml}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:architecture": "vitest run tests/architecture",
    "check:docs": "tsx scripts/check-docs.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:architecture && pnpm check:docs",
    "qaw": "tsx --conditions=development apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.22.0",
    "jsdom": "30.1.0",
    "prettier": "^3.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "@playwright/test": "^1.63.0"
  }
}
